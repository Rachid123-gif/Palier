# ═══════════════════════════════════════════════════
# Palier — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════

# ── Supabase (REQUIRED) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Session (REQUIRED) ──
SESSION_SECRET=generate-a-random-32-char-string

# ── Admin (REQUIRED) ──
PLATFORM_ADMIN_SECRET=your-admin-secret
ADMIN_PHONE=+212600000000

# ── SMS Provider (REQUIRED — choose one) ──
SMS_PROVIDER=infobip
# If infobip:
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=your-base.api.infobip.com
INFOBIP_SENDER=Palier
# If twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_FROM_NUMBER=+1234567890

# ── Push Notifications (recommended) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@palier.ma

# ── Internal API (recommended) ──
INTERNAL_API_SECRET=generate-a-random-secret

# ── App URL (recommended) ──
NEXT_PUBLIC_APP_URL=https://palier.ma
NEXT_PUBLIC_APP_DOMAIN=palier.ma

# ── Google Places (optional) ──
GOOGLE_PLACES_API_KEY=

# ── Beta gate (optional — set to enable) ──
# BETA_ACCESS_CODE=1

# ── Development only (NEVER set in production) ──
# SKIP_SMS=1
